{
  "name": "@acct/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@acct/crypto": "workspace:*",
    "@acct/db": "workspace:*",
    "@acct/shared": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
