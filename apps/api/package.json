{
  "name": "@acct/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "jobs:install": "node --env-file-if-exists=../../.env dist/jobs/install-cli.js",
    "ats": "node --env-file-if-exists=../../.env dist/efile/ats/run-ats.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "perf": "vitest run -c vitest.perf.config.mts"
  },
  "dependencies": {
    "@acct/crypto": "workspace:*",
    "@acct/db": "workspace:*",
    "@acct/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.129.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "cookie-parser": "^1.4.7",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "mailparser": "^3.9.31",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.37.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/autocannon": "^7.12.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
