# Copy to terraform.tfvars and fill in. Nothing here is secret.
account_id            = "111111111111"
production_account_id = "222222222222"
domain_name           = "books-staging.example.com"
route53_zone_id       = "Z0000000000000000000"
mail_domain           = "mail-staging.example.com"
mail_from             = "Books (staging) <no-reply@mail-staging.example.com>"
alarm_emails          = ["ops@example.com"]
# The first deploy's images (built and pushed by the deploy workflow, or by hand).
api_image = "111111111111.dkr.ecr.us-east-1.amazonaws.com/acct/api:<git sha>"
web_image = "111111111111.dkr.ecr.us-east-1.amazonaws.com/acct/web:<git sha>"
# Providers stay off ('none') unless turned on here, with their credentials as secrets.
app_settings = {
  # BANK_FEED_PROVIDER = "plaid"
  # PLAID_ENV          = "sandbox"
}
provider_secret_names = [
  # "PLAID_CLIENT_ID", "PLAID_SECRET",
]
