# Copy to .env at the repo root. Values below are for LOCAL DEVELOPMENT ONLY.

# Superuser/owner connection used by `pnpm db:setup` and `pnpm db:migrate`.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/acct_dev
# Password for the non-owner application role (acct_app) that is subject to Row-Level Security.
APP_DB_PASSWORD=acct_app_dev_password
# Connection used by the API at runtime. MUST be the acct_app role, never the owner.
DATABASE_URL=postgres://acct_app:acct_app_dev_password@localhost:5432/acct_dev
# Connections per API or worker process (keep processes x pool under the database's max_connections).
# DB_POOL_SIZE=10

# Field encryption (ADR 0029). Development: one key from the environment ('env').
# Production: FIELD_KEY_PROVIDER=aws-kms with FIELD_KMS_KEY_ID (a key or alias ARN) and SIGNING_KEY;
# the data keys live wrapped in field_keys (`pnpm --filter @acct/api keys:rotate`).
# 32-byte keys, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_KEY_PROVIDER=env
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktZmllbGQtZW5jcnlwdGlvbi1rZXktISE=
# FIELD_KMS_KEY_ID=arn:aws:kms:us-east-1:111122223333:alias/acct-field-keys
# Signs download links and OAuth state; falls back to FIELD_ENCRYPTION_KEY with 'env'.
# SIGNING_KEY=

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false

# Bank feeds: 'mock' (development bank), 'plaid' or 'none' (file imports only).
BANK_FEED_PROVIDER=mock
# Online payments: stripe | mock (the stand-in) | none. Stripe needs the platform's keys.
PAYMENTS_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Electronic filing (Forms 941, 940 and 1099): stand-in (plays the IRS) | none.
EFILE_TRANSMITTER=stand-in
# Federal tax payments through EFTPS as batch provider: stand-in | none (pay in EFTPS by hand).
EFTPS_BATCH_PROVIDER=stand-in
# Direct deposit through a payments partner: stand-in | none (NACHA files only).
DEPOSIT_PARTNER=stand-in
# State and local payroll taxes beyond the built-in states: none (those paychecks are refused).
# 'test-fixture' is for tests only. A licensed tax engine is added once one is contracted.
PAYROLL_TAX_ENGINE=none
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_WEBHOOK_URL=https://your-domain/api/webhooks/plaid

# Documents: local encrypted storage and the dev virus scanner (production needs s3 + clamd).
DOCUMENT_STORAGE=local
DOCUMENT_STORAGE_DIR=.documents
VIRUS_SCANNER=dev
# Receipt reading: 'heuristic' (text-based PDFs), 'anthropic' (Claude reads photos and PDFs) or 'none'.
DOCUMENT_AI=heuristic
# ANTHROPIC_API_KEY=
# Email-in: <token>@INBOUND_EMAIL_DOMAIN; the mail provider signs each message with the secret.
# INBOUND_EMAIL_DOMAIN=in.example.com
# INBOUND_EMAIL_SECRET=

# QuickBooks migration: 'mock' serves a demo QuickBooks Online company (development only);
# 'sandbox' or 'production' need an Intuit Developer app; 'none' turns the connector off.
QBO_ENVIRONMENT=mock
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:3000/api/migration/qbo/callback
# Days a QuickBooks Desktop agent pairing key stays valid.
MIGRATION_AGENT_KEY_DAYS=7
# Background jobs (ADR 0027): the queue lives in Postgres ('pg-boss'; `pnpm db:migrate` installs
# it). JOB_WORKER=on runs jobs and schedules in this process (one-process development); in
# production run the API with JOB_WORKER=off and `pnpm --filter @acct/api worker` beside it.
JOB_QUEUE=pg-boss
JOB_WORKER=on
