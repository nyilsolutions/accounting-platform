{
  "name": "accounting-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "pnpm --filter @acct/db run setup",
    "db:migrate": "pnpm --filter @acct/db run migrate && pnpm --filter @acct/api run jobs:install",
    "db:seed": "pnpm --filter @acct/api run seed",
    "e2e": "pnpm --filter @acct/web run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
